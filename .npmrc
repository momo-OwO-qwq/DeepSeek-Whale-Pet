# npm 配置
#
# registry 走国内镜像（本机 github.com 不可达，且 Electron 二进制下载依赖镜像）
registry=https://registry.npmmirror.com

# 缓存放到项目内可写目录（本机 ~/.npm 为 root 所有，写不进去）
cache=.npm-cache

# Electron 的 postinstall 必须执行（新版 npm 默认拦截安装脚本 → 二进制下载不下来）。
# 若你的 npm 支持 allowScripts，也可用 `npm install-scripts approve electron` 替代。
ignore-scripts=false
